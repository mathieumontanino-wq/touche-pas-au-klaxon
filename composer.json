{
    "name": "klaxon/touche-pas-au-klaxon",
    "description": "Application de covoiturage inter-sites",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "izniburak/router": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
